<Window x:Class="EuroTruckHaptics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETS2 DualSense Haptics" Height="720" Width="1120"
        MinHeight="620" MinWidth="960" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="ROAD FEEL" Foreground="{StaticResource AccentBrush}"
                           FontSize="12" FontWeight="Bold" />
                <TextBlock Text="ETS2 DualSense Haptics" FontSize="28" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="LOCAL ENGINE / NO CLOUD DEPENDENCY"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Background="#382B1D" CornerRadius="8" Padding="14" Margin="0,0,0,20">
            <TextBlock x:Name="ConnectionBannerText" TextWrapping="Wrap" Foreground="#F6C77A"
                       Text="Connections are not configured. Live outputs remain disabled until ETS2 telemetry and a verified DualSense transport are connected." />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="LIVE TELEMETRY" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SPEED" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="SpeedValue" Text="--" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="km/h" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ENGINE RPM" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="RpmValue" Text="--" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="rpm" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GEAR" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="GearValue" Text="--" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="not available" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Grid>
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock x:Name="TruckValue" Text="Truck: unavailable"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="SurfaceValue" Text="Road surface: unavailable"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="CURRENT EVENT" FontSize="14" FontWeight="Bold" Margin="0,24,0,12" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
                    <TextBlock x:Name="EventStatus" Text="Waiting for live telemetry"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="MIXER TARGETS - NOT HARDWARE OUTPUT" FontSize="14"
                           FontWeight="Bold" Margin="0,0,0,12" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="LEFT ACTUATOR" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar x:Name="LeftActuatorBar" Height="9" Margin="0,7,0,16" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock Text="RIGHT ACTUATOR" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar x:Name="RightActuatorBar" Height="9" Margin="0,7,0,16" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock Text="L2 - BRAKE RESISTANCE" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar x:Name="L2Bar" Height="9" Margin="0,7,0,16" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock Text="R2 - THROTTLE RESISTANCE" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar x:Name="R2Bar" Height="9" Margin="0,7,0,4" Minimum="0" Maximum="1" Value="0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="DIAGNOSTICS" FontSize="14" FontWeight="Bold" Margin="0,24,0,12" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TelemetryRateText" Text="Telemetry update rate: --"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="USB output latency — (not measured)" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Haptic core: local and deterministic  |  Hardware validation: pending"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock DockPanel.Dock="Right" Text="v0.1 - FOUNDATION"
                       Foreground="{StaticResource AccentBrush}" FontSize="11" />
        </DockPanel>
    </Grid>
</Window>
